# Go HTTP server and persistent data paths for native development.
# compose.yaml overrides these with the container paths.
TOFI_LISTEN=127.0.0.1:8321
TOFI_DATA_DIR=./data
TOFI_UI_DIR=./ui/dist

# Leave empty for localhost-only access. A TLS reverse proxy should set this
# to the public https:// origin for same-origin write checks.
TOFI_PUBLIC_ORIGIN=

TOFI_HOST_PORT=8321
# Keep loopback for SSH access; a dedicated trusted-LAN installation may bind
# 0.0.0.0. Do not expose this single-user service directly to the public internet.
TOFI_HOST_BIND=127.0.0.1

# Model configuration. The Alpha default is Codex; the UI starts with a clear
# missing-model state until the owner completes the Codex device login.
TOFI_MODEL_PROVIDER=openai_codex
TOFI_MODEL=codex-gpt-5.6-luna
TOFI_MODEL_API_KEY=
TOFI_MODEL_BASE_URL=

# Optional remote MCP config and read-only skill catalog.
# Defaults: <TOFI_DATA_DIR>/mcp.json when present, <TOFI_DATA_DIR>/skills.
TOFI_MCP_CONFIG=
TOFI_SKILLS_DIR=
TOFI_TRIAGE_MODEL=codex-gpt-5.6-luna
