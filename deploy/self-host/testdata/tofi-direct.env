# Synthetic direct-mode (default, self-signed HTTPS) fixture for `docker compose config` checks.
TOFI_VERSION=v0.0.0-rc.1
TOFI_DOMAIN=
TOFI_EMAIL=
TOFI_HTTP_PORT=8321
TOFI_BIND=0.0.0.0
TOFI_PUBLIC_ORIGIN=
TOFI_APP_IMAGE=ghcr.io/jackzhao98/tofi@sha256:1111111111111111111111111111111111111111111111111111111111111111
TOFI_WORKER_IMAGE=ghcr.io/jackzhao98/tofi-worker@sha256:2222222222222222222222222222222222222222222222222222222222222222
TOFI_CADDY_IMAGE=docker.io/library/caddy@sha256:3333333333333333333333333333333333333333333333333333333333333333
TOFI_GUEST_VERSION=v0.0.0-rc.1
TOFI_CPU_BUDGET=3
TOFI_MEMORY_BUDGET_MIB=6144
TOFI_WORKER_MEMORY_LIMIT=6400m
TOFI_TLS_CERT_FILE=/etc/tofi-tls/cert.pem
TOFI_TLS_KEY_FILE=/etc/tofi-tls/key.pem
TOFI_OWNER_ALLOW_LAN_HTTP=0
