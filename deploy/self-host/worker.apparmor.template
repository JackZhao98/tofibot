# Production review artifact; compile only until the coordinating cutover is authorized.
#include <tunables/global>
profile tofi-account-worker flags=(attach_disconnected,mediate_deleted) {
  # Read/execute own immutable image and libraries; write only owned fixture paths.
  /** rixm,
  / rw,
  /run/ rw,
  /firecracker.pid rw,
  /dev/userfaultfd rw,
  /run/** rwkl,
  /tmp/** rwkl,
  /var/lib/tofi-worker/** rwkl,
  /sys/fs/cgroup/** rwkl,
  /proc/sys/net/ipv4/ip_forward rw,
  /proc/sys/net/ipv6/conf/all/disable_ipv6 rw,
  /dev/{null,zero,random,urandom,kvm} rw,
  /dev/net/tun rw,
  /dev/ rw,
  /dev/net/ rw,
  /firecracker ix,
  /workspace.ext4 rw,
  /old_root/ rw,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/kcore rwklx,
  deny /sys/kernel/security/** wklx,
  network unix,
  network inet,
  network inet6,
  network netlink,
  capability sys_admin,
  capability net_admin,
  capability mknod,
  capability sys_chroot,
  capability setuid,
  capability setgid,
  capability chown,
  capability dac_override,
  capability fowner,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (send,receive) peer=tofi-account-worker,
  ptrace (trace,tracedby,read,readby) peer=tofi-account-worker,
  mount fstype=cgroup2 options=(rw,nosuid,nodev,noexec,silent) -> /run/tofi-worker/cgroup/,
  mount options=(bind) /run/tofi-worker/cgroup/ -> /sys/fs/cgroup/,
  mount options=(rslave) -> /,
  umount /old_root/,
  umount /run/tofi-worker/cgroup/,
  mount options=(rbind) /run/netns/ -> /run/netns/,
  mount options=(rshared) -> /run/netns/,
  mount options=(rslave) -> /run/netns/,
  # Kernel audit canonicalizes the nsfs magic-link source to "/". The target
  # is the fixed file handle created by ip netns, not a directory/root mount.
  umount /sys/,
  mount fstype=sysfs options=(rw) -> /sys/,
  mount options=(bind) /proc/sys/net/ipv4/ip_forward -> /proc/sys/net/ipv4/ip_forward,
  mount options=(bind) /proc/sys/net/ipv6/conf/all/disable_ipv6 -> /proc/sys/net/ipv6/conf/all/disable_ipv6,
  mount options=(remount,bind,rw,nosuid,nodev,noexec,relatime) -> /proc/sys/net/ipv4/ip_forward,
  mount options=(remount,bind,rw,nosuid,nodev,noexec,relatime) -> /proc/sys/net/ipv6/conf/all/disable_ipv6,
  mount options=(rbind) /var/lib/tofi-worker/state/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/jails/firecracker/ac-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/root/ -> /var/lib/tofi-worker/state/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/jails/firecracker/ac-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/root/,
  pivot_root oldroot=/var/lib/tofi-worker/state/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/jails/firecracker/ac-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/root/old_root/ /var/lib/tofi-worker/state/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/jails/firecracker/ac-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/root/,
  umount /sys/fs/cgroup/,
  mount options=(bind) /proc/[0-9]*/ns/net -> /run/netns/tofi-fc-{[1-9],[1-9][0-9],1[0-9][0-9],2[0-4][0-9],250},
  mount options=(bind) / -> /run/netns/tofi-fc-{[1-9],[1-9][0-9],1[0-9][0-9],2[0-4][0-9],250},
  umount /run/netns/tofi-fc-{[1-9],[1-9][0-9],1[0-9][0-9],2[0-4][0-9],250},
}
