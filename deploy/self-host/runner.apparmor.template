# AppArmor profile of the MCP Runner container.
#
# It is Docker's default profile (docker-default) plus exactly one mount permission: the
# Runner may remount the container's own cgroup2 view (/sys/fs/cgroup, a private cgroup
# namespace, see compose.yaml `cgroup: private`) read-write. Docker mounts that view
# read-only, and the default profile denies every mount, so without this the Runner cannot
# create the per-account cgroups that carry the memory and process limits.
#
# Nothing else is allowed: no other mount, no pivot_root, no new cgroup2 mount, no change
# to what the private view contains. Everything Docker denies by default stays denied
# (writes to most of /proc and /sys, /proc/kcore, /sys/kernel/security, ...).
#include <tunables/global>
profile tofi-runner flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # Signals from privileged profiles and from within this profile.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (send,receive) peer=tofi-runner,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # The one mount permission: make the container's own cgroup2 view writable.
  mount options=(remount,bind,rw,nosuid,nodev,noexec) -> /sys/fs/cgroup/,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=tofi-runner,
}
