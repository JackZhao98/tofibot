        }
      },
      {
        "id": "motion",
        "note": "Motion vocabulary (one scale; the guard is scripts/test-motion-tokens.mjs, the JS mirror is motion.ts and the generated tokens.ts).\nDurations: instant = hover fades, press = pressed feedback, quick = toggles, tooltips and fades, base = arrivals, disclosures and glides, panel-in and panel-out = panels, drawers, dialogs and page pushes (leaving is about 35% shorter), flight = the send flight only.\nEasings: out = default, settle = exits, spring = the one small-object bounce (never layout), inout = travelling things, in = things that leave for good, pop = popups (a fast start that settles softly), pen = the tick stroke, stamp = the approval stamp.\nArrival and mark timings run once, when a state changes.",
        "tokens": {
          "ease-press": "var(--m-press)",
          "m-instant": "80ms",
          "m-press": "120ms",
          "m-quick": "140ms",
          "m-base": "220ms",
          "m-panel-in": "280ms",
          "m-panel-out": "180ms",
          "m-flight": "640ms",
          "ease-out": "cubic-bezier(.22,1,.36,1)",
          "ease-settle": "cubic-bezier(.2,.8,.2,1)",
          "ease-spring": "cubic-bezier(.34,1.3,.64,1)",
          "ease-inout": "cubic-bezier(.45,0,.2,1)",
          "ease-in": "cubic-bezier(.5,0,.75,0)",
          "ease-pop": "cubic-bezier(.16,1,.3,1)",
          "m-pop-in": "180ms",
          "m-pop-out": "120ms",
          "ease-pen": "cubic-bezier(.3, .7, .2, 1)",
          "ease-stamp": "cubic-bezier(.34, 1.4, .64, 1)",
          "m-arrive": "220ms",
          "m-arrive-reduced": "120ms",
          "m-mark-fill": "120ms",
          "m-mark-tick": "240ms",
          "m-mark-strike": "280ms",
          "m-mark-strike-delay": "120ms",
          "m-mark-hl": "340ms",
          "m-mark-hl-delay": "160ms",
          "m-mark-stamp": "240ms"
        }
      },
